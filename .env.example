# Database (Supabase: pooler URL with ?pgbouncer=true; DIRECT_URL = direct/session connection for migrations)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL=""

# Auth
SESSION_SECRET=""          # long random string
OWNER_PHONE=""             # e.g. 0501234567
SETTINGS_ENCRYPTION_KEY="" # 32 characters

# AI
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="gemini"

# Production
APP_URL=""
LAMBDA_GENERATE_URL=""
BG_SECRET=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET=""

# Photo store (/shop) — see src/shop/README.md. Uses OPENAI_API_KEY above.
NEXT_PUBLIC_SHOP_WHATSAPP=""      # e.g. 972501234567 — receives orders
SHOP_DAILY_LIMIT_PER_CLIENT="3"   # uploads per visitor per 24h (each = 4 images)
SHOP_DAILY_LIMIT_TOTAL="100"      # uploads for the whole store per 24h
NEXT_PUBLIC_SHOP_URL=""           # dashboard button target once the store has its own domain
SHOP_RETENTION_DAYS="30"          # unordered uploads/results are deleted after this many days
SHOP_UNLIMITED_PHONES=""        # extra phones (comma-separated) with no daily limit; OWNER_PHONE always has none when logged in
