generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  phone                 String   @unique
  restaurantName        String?
  restaurantLogo        String?
  restaurantStyle       String?
  restaurantUrl         String?
  restaurantDescription String?
  restaurantTheme       String?
  canSingleGenerate     Boolean  @default(true)
  canMultiGenerate      Boolean  @default(false)
  niroBarCustomFeatures String?
  /// OWNER | MEMBER — full business access; STUDIO_ONLY — AI studio + own gallery only
  role                  String   @default("STUDIO_ONLY")
  createdAt             DateTime @default(now())
  menus                 Menu[]
  generationJobs        GenerationJob[]
  mediaAssets           MediaAsset[]
}

model Menu {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  styleKey  String?
  rawText   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dishes    Dish[]

  @@index([userId])
  @@index([userId, createdAt])
}

model Dish {
  id             String      @id @default(cuid())
  menuId         String
  menu           Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          String?
  category       String
  ingredients    String
  prompt         String
  status         String      @default("PENDING")
  hidden         Boolean     @default(false)
  imageUrl       String?
  referenceImage String?
  mediaType      String      @default("image")
  videoUrl       String?
  videoOpId      String?
  errorMessage   String?
  retryCount     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  images         DishImage[]

  @@index([menuId])
  @@index([status])
  @@index([menuId, status])
}

model DishImage {
  id        String   @id @default(cuid())
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  imageUrl  String
  createdAt DateTime @default(now())

  @@index([dishId])
}

model Settings {
  id        String   @id @default("singleton")
  data      String
  updatedAt DateTime @updatedAt
}

/// One AI generation request (single or part of a multi batch).
model GenerationJob {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId        String?
  /// PENDING | GENERATING | DONE | ERROR
  status         String      @default("PENDING")
  title          String
  prompt         String
  styleKey       String?
  options        Json?
  referenceImage String?
  extraImages    Json?
  errorMessage   String?
  retryCount     Int         @default(0)
  mediaAssetId   String?     @unique
  mediaAsset     MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([batchId])
}

/// Every image/video the AI produced — independent of menus, customers or quotes.
model MediaAsset {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// image | video
  kind           String         @default("image")
  url            String
  title          String
  styleKey       String?
  prompt         String?
  sourceImageUrl String?
  parentAssetId  String?
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Set for assets backfilled from the legacy Dish/DishImage tables
  legacyDishId   String?
  legacyImageId  String?        @unique
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  job            GenerationJob?

  @@index([userId, createdAt])
  @@index([customerId])
  @@index([legacyDishId])
}

/// The business's own details (single business). Used on quotes and receipts.
model BusinessProfile {
  id                  String   @id @default("main")
  businessName        String   @default("")
  logoUrl             String?
  /// עוסק מורשה / פטור / ח.פ — the number printed on documents
  taxId               String   @default("")
  /// EXEMPT (עוסק פטור) | LICENSED (עוסק מורשה) | COMPANY (חברה בע"מ)
  vatType             String   @default("EXEMPT")
  address             String   @default("")
  phone               String   @default("")
  email               String   @default("")
  documentFooter      String   @default("")
  brandColor          String   @default("#B8862B")
  defaultPaymentTerms String   @default("")
  /// Saved services for quotes: [{ description, unitPrice (agorot) }]
  savedServices       Json     @default("[]")
  updatedAt           DateTime @updatedAt
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String       @default("")
  email       String       @default("")
  /// ח.פ / ע.מ / ת.ז
  taxId       String       @default("")
  address     String       @default("")
  notes       String       @default("")
  /// LEAD | QUOTE_SENT | ACTIVE | INACTIVE
  status      String       @default("LEAD")
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  mediaAssets MediaAsset[]

  @@index([name])
  @@index([phone])
  @@index([status])
}

/// Append-only log of sensitive actions; also feeds customer timelines and the dashboard.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  /// e.g. customer.created, customer.updated, quote.sent, receipt.issued
  action     String
  entityType String
  entityId   String
  customerId String?
  summary    String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
