generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection for migrations. Supabase's transaction
  /// pooler (port 6543) can't run migrations. db-setup fills it in when unset.
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String   @id @default(cuid())
  phone                 String   @unique
  restaurantName        String?
  restaurantLogo        String?
  restaurantStyle       String?
  restaurantUrl         String?
  restaurantDescription String?
  restaurantTheme       String?
  canSingleGenerate     Boolean  @default(true)
  canMultiGenerate      Boolean  @default(false)
  niroBarCustomFeatures String?
  /// OWNER | MEMBER — full business access; STUDIO_ONLY — AI studio + own gallery only
  role                  String   @default("STUDIO_ONLY")
  createdAt             DateTime @default(now())
  menus                 Menu[]
  generationJobs        GenerationJob[]
  mediaAssets           MediaAsset[]
}

model Menu {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  styleKey  String?
  rawText   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dishes    Dish[]

  @@index([userId])
  @@index([userId, createdAt])
}

model Dish {
  id             String      @id @default(cuid())
  menuId         String
  menu           Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          String?
  category       String
  ingredients    String
  prompt         String
  status         String      @default("PENDING")
  hidden         Boolean     @default(false)
  imageUrl       String?
  referenceImage String?
  mediaType      String      @default("image")
  videoUrl       String?
  videoOpId      String?
  errorMessage   String?
  retryCount     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  images         DishImage[]

  @@index([menuId])
  @@index([status])
  @@index([menuId, status])
}

model DishImage {
  id        String   @id @default(cuid())
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  imageUrl  String
  createdAt DateTime @default(now())

  @@index([dishId])
}

model Settings {
  id        String   @id @default("singleton")
  data      String
  updatedAt DateTime @updatedAt
}

/// One AI generation request (single or part of a multi batch).
model GenerationJob {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId        String?
  /// PENDING | GENERATING | DONE | ERROR
  status         String      @default("PENDING")
  title          String
  prompt         String
  styleKey       String?
  options        Json?
  referenceImage String?
  extraImages    Json?
  errorMessage   String?
  retryCount     Int         @default(0)
  mediaAssetId   String?     @unique
  mediaAsset     MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([batchId])
}

/// Every image/video the AI produced — independent of menus, customers or quotes.
model MediaAsset {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// image | video
  kind           String         @default("image")
  url            String
  title          String
  styleKey       String?
  prompt         String?
  sourceImageUrl String?
  parentAssetId  String?
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Set for assets backfilled from the legacy Dish/DishImage tables
  legacyDishId   String?
  legacyImageId  String?        @unique
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  job            GenerationJob?

  @@index([userId, createdAt])
  @@index([customerId])
  @@index([legacyDishId])
}

/// The business's own details (single business). Used on quotes and receipts.
model BusinessProfile {
  id                  String   @id @default("main")
  businessName        String   @default("")
  logoUrl             String?
  /// עוסק מורשה / פטור / ח.פ — the number printed on documents
  taxId               String   @default("")
  /// EXEMPT (עוסק פטור) | LICENSED (עוסק מורשה) | COMPANY (חברה בע"מ)
  vatType             String   @default("EXEMPT")
  address             String   @default("")
  phone               String   @default("")
  email               String   @default("")
  documentFooter      String   @default("")
  brandColor          String   @default("#B8862B")
  defaultPaymentTerms String   @default("")
  /// Saved services for quotes: [{ description, unitPrice (agorot) }]
  savedServices       Json     @default("[]")
  /// VAT percent applied by LICENSED/COMPANY businesses
  vatRate             Int      @default(18)
  /// Set when the first-run business setup was completed
  setupCompletedAt    DateTime?
  updatedAt           DateTime @updatedAt
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String       @default("")
  email       String       @default("")
  /// ח.פ / ע.מ / ת.ז
  taxId       String       @default("")
  address     String       @default("")
  notes       String       @default("")
  /// LEAD | QUOTE_SENT | ACTIVE | INACTIVE
  status      String       @default("LEAD")
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  mediaAssets MediaAsset[]
  quotes      Quote[]
  payments    Payment[]
  receipts    Receipt[]

  @@index([name])
  @@index([phone])
  @@index([status])
}

/// Append-only log of sensitive actions; also feeds customer timelines and the dashboard.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  /// e.g. customer.created, customer.updated, quote.sent, receipt.issued
  action     String
  entityType String
  entityId   String
  customerId String?
  summary    String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Gapless sequential numbering per document type ("quote", "receipt").
/// `next` is the number the next document will get; incremented in the same
/// transaction that creates the document.
model DocumentCounter {
  key       String   @id
  next      Int
  updatedAt DateTime @updatedAt
}

/// Money fields are integer agorot.
model Quote {
  id               String    @id @default(cuid())
  number           Int
  version          Int       @default(1)
  parentQuoteId    String?
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// DRAFT | SENT | APPROVED | REJECTED | EXPIRED
  status           String    @default("DRAFT")
  /// GENERAL | NIRO_BAR
  template         String    @default("GENERAL")
  title            String    @default("")
  /// Event / service type, e.g. "חתונה"
  serviceType      String    @default("")
  clientRole       String    @default("")
  eventDate        DateTime?
  location         String    @default("")
  guestCount       Int?
  /// TOTAL (package price) | PER_PERSON (tiers by guest count) | ITEMS (line items only)
  priceMode        String    @default("TOTAL")
  packagePrice     Int       @default(0)
  /// [{ min?: number, max?: number, price: agorot }]
  tiers            Json      @default("[]")
  /// AMOUNT (agorot) | PERCENT (basis points, 1000 = 10%)
  discountType     String    @default("AMOUNT")
  discountValue    Int       @default(0)
  pricesIncludeVat Boolean   @default(false)
  extraHourPrice   Int?
  depositAmount    Int?
  paymentTerms     String    @default("")
  validUntil       DateTime?
  clientNotes      String    @default("")
  internalNotes    String    @default("")
  /// NIRO BAR "מה מחכה לכם?" checklist: [{ title, description }]
  niroFeatures     Json      @default("[]")
  gift             String    @default("")
  /// Totals — always recomputed on the server by quote-math
  subtotal         Int       @default(0)
  discountAmount   Int       @default(0)
  vatRate          Int       @default(0)
  vatAmount        Int       @default(0)
  total            Int       @default(0)
  shareToken       String    @unique
  /// Designed NIRO BAR flyer (MediaAsset id)
  designAssetId    String?
  sentAt           DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  items            QuoteItem[]
  payments         Payment[]
  receipts         Receipt[]

  @@unique([number, version])
  @@index([customerId])
  @@index([status])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float  @default(1)
  unitPrice   Int
  sortOrder   Int    @default(0)

  @@index([quoteId])
}

/// One payment line of a receipt. Immutable (enforced by a DB trigger).
model Payment {
  id            String    @id @default(cuid())
  receiptId     String
  receipt       Receipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  /// CASH | TRANSFER | BIT | CREDIT | CHEQUE | OTHER
  method        String
  amount        Int
  receivedAt    DateTime
  /// Transfer reference / last 4 digits / app reference
  reference     String    @default("")
  chequeNumber  String    @default("")
  chequeBank    String    @default("")
  chequeBranch  String    @default("")
  chequeAccount String    @default("")
  chequeDueDate DateTime?
  createdAt     DateTime  @default(now())

  @@index([customerId])
  @@index([quoteId])
  @@index([receiptId])
}

/// Legal receipt. Rendered only from `snapshot`; immutable except status
/// (ISSUED → CANCELLED), printCount and originalChannel — enforced by a DB trigger.
model Receipt {
  id               String    @id @default(cuid())
  number           Int       @unique
  /// RECEIPT | CANCELLATION
  type             String    @default("RECEIPT")
  /// ISSUED | CANCELLED
  status           String    @default("ISSUED")
  issuedAt         DateTime  @default(now())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteId          String?
  quote            Quote?    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  total            Int
  description      String
  snapshot         Json
  contentHash      String
  cancelsReceiptId String?   @unique
  cancels          Receipt?  @relation("ReceiptCancellation", fields: [cancelsReceiptId], references: [id], onDelete: Restrict)
  cancelledBy      Receipt?  @relation("ReceiptCancellation")
  cancelReason     String    @default("")
  shareToken       String    @unique
  printCount       Int       @default(0)
  /// PRINT | SHARE — which channel produced the single "מקור"
  originalChannel  String?
  createdById      String?
  createdAt        DateTime  @default(now())
  payments         Payment[]

  @@index([customerId])
  @@index([issuedAt])
}
