generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  phone                 String   @unique
  restaurantName        String?
  restaurantLogo        String?
  restaurantStyle       String?
  restaurantUrl         String?
  restaurantDescription String?
  restaurantTheme       String?
  canSingleGenerate     Boolean  @default(true)
  canMultiGenerate      Boolean  @default(false)
  niroBarCustomFeatures String?
  // Receipt issuer details (printed on every receipt)
  businessName          String?
  businessTaxId         String?
  businessAddress       String?
  businessPhone         String?
  businessType          String   @default("exempt") // exempt | licensed
  receiptCounter        Int      @default(0)        // last issued receipt number
  createdAt             DateTime @default(now())
  menus                 Menu[]
  customers             Customer[]
  receipts              Receipt[]
}

model Menu {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  styleKey  String?
  rawText   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dishes    Dish[]

  @@index([userId])
  @@index([userId, createdAt])
}

model Dish {
  id             String      @id @default(cuid())
  menuId         String
  menu           Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          String?
  category       String
  ingredients    String
  prompt         String
  status         String      @default("PENDING")
  hidden         Boolean     @default(false)
  imageUrl       String?
  referenceImage String?
  mediaType      String      @default("image")
  videoUrl       String?
  videoOpId      String?
  errorMessage   String?
  retryCount     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  images         DishImage[]

  @@index([menuId])
  @@index([status])
  @@index([menuId, status])
}

model DishImage {
  id        String   @id @default(cuid())
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  imageUrl  String
  createdAt DateTime @default(now())

  @@index([dishId])
}

model Customer {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  company   String?
  taxId     String?
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  receipts  Receipt[]

  @@unique([userId, phone])
  @@index([userId, fullName])
}

// Receipts are never deleted – only cancelled – and keep a snapshot of the
// customer/issuer details as they were at issue time.
model Receipt {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  number          Int
  issueDate       DateTime  @default(now())
  amount          Decimal   @db.Decimal(12, 2)
  paymentMethod   String    // cash | bit | paybox | transfer | check | credit | other
  paymentRef      String?
  description     String?
  customerName    String
  customerPhone   String
  customerCompany String?
  customerTaxId   String?
  issuerName      String?
  issuerTaxId     String?
  issuerAddress   String?
  issuerPhone     String?
  issuerType      String    @default("exempt")
  status          String    @default("ACTIVE") // ACTIVE | CANCELLED
  cancelReason    String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userId, number])
  @@index([userId, issueDate])
  @@index([customerId])
}

model Settings {
  id        String   @id @default("singleton")
  data      String
  updatedAt DateTime @updatedAt
}
